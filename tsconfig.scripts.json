// Types of the TypeScript scripts in scripts/, for `npm run typecheck:scripts` (a step of `verify`, #297).
// ts-node checks a script only when someone runs it and the build sees only src/; the glob covers a new script too.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"]
}
