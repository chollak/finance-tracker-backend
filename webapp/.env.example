# WebApp Configuration

# Telegram Bot username (without @)
# Used for links to the bot from the usage limits (the web login takes its link from the server, FT-128)
VITE_TG_BOT_USERNAME=FinanceTrackerAppBot

# API Base URL (optional, defaults to relative path)
# VITE_API_BASE_URL=http://localhost:3000/api

# Development outside Telegram (npm run dev:full, http://localhost:5173): open the app as this Telegram user without
# the web login. Requests carry X-Dev-User-Id, which the backend takes only outside production. Without it the dev
# server shows the login screen, and that login needs the real bot and Telegram to finish (FT-128)
# VITE_MOCK_USER_ID=123456789
# VITE_MOCK_USER_NAME=Dev User
