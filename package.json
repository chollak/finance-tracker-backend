{
  "name": "finance-tracker-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "npx tsc",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "serve": "node dist/index.js",
    "dev": "ts-node-dev src/index.ts",
    "dev:full": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev\" \"cd webapp && npm run dev\"",
    "dev:backend": "ts-node-dev src/index.ts",
    "dev:frontend": "cd webapp && npm run dev",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "install:webapp": "cd webapp && npm install",
    "build:webapp": "cd webapp && npm run build",
    "postinstall": "npm run install:webapp && npm run build:webapp",
    "format": "prettier --write src/**/*.ts",
    "check:deps": "dependency-cruiser --validate .dependency-cruiser.js src",
    "check:fonts": "node scripts/check-selfhosted-fonts.js",
    "tokens:pastel": "node scripts/generate-pastel-tokens.js",
    "check:tokens": "node scripts/generate-pastel-tokens.js --check",
    "analyze": "npm run check:deps",
    "verify": "npm run build && npm run typecheck:tests && npm run typecheck:scripts && npm run lint:webapp && npm run test:ci && npm run test:webapp && npm run build:webapp && npm run check:fonts && npm run check:tokens && npm run analyze",
    "migration:show": "npm run build && node dist/shared/infrastructure/database/migrate.js show",
    "migration:run": "npm run build && node dist/shared/infrastructure/database/migrate.js run",
    "migration:revert": "npm run build && node dist/shared/infrastructure/database/migrate.js revert",
    "supabase:setup": "npx ts-node scripts/create-tables.ts",
    "supabase:test": "npx ts-node scripts/test-supabase.ts",
    "seed:test": "npx ts-node scripts/seed-test-data.ts",
    "report:quality": "npx ts-node scripts/capture-quality-report.ts",
    "design:audit": "node scripts/mobile-ui-audit.js",
    "miniapp:menu": "node scripts/dev-miniapp.js",
    "dev:miniapp": "node scripts/dev-miniapp.js run",
    "test:webapp": "cd webapp && npm run test",
    "lint:webapp": "cd webapp && npm run lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.86.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.2.1",
    "openai": "^7.47.0",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^6.0.1",
    "telegraf": "^4.12.2",
    "typeorm": "^0.3.25",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.4",
    "@types/node": "^22.7.6",
    "concurrently": "^9.2.0",
    "dependency-cruiser": "^17.0.1",
    "jest": "^29.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
