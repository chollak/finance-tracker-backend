# Application Configuration
NODE_ENV=development
PORT=3000

# Database: SQLite via TypeORM is the only option (data/database.sqlite).
# Schema changes are migrations applied on start; see docs/knowledge-base/08-development/database-guide.md
DATABASE_TYPE=sqlite

# Free-tier limits (50 records, 10 voice inputs a month). Off during milestone 10 (decision Д3).
FREE_LIMITS_ENABLED=false

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4-turbo
WHISPER_MODEL=whisper-1
DEFAULT_LANGUAGE=ru

# Telegram Bot
TG_BOT_API_KEY=your-telegram-bot-token
# Optional: the bot's @username (without @) for the web login link t.me/<bot>?start=login_… (FT-128).
# When empty the server asks Telegram (getMe).
TG_BOT_USERNAME=
WEB_APP_URL=http://localhost:3000
# Optional: chat/user id used by npm run dev:miniapp / miniapp:menu helpers to update Telegram menu button
MINIAPP_CHAT_ID=
# Optional: use an ngrok URL in local development; AppConfig prefers it when NODE_ENV=development
NGROK_URL=

# Quick Capture — iPhone Shortcut direct API (DEV/TEST ONLY, FT-075)
# Optional shared token for POST /api/quick-capture with the X-Shortcut-User-Id header.
# When set, the Shortcut must also send X-Shortcut-Capture-Token with the same value.
# The whole bypass is refused with 403 when NODE_ENV=production — it is not a production auth model.
SHORTCUT_CAPTURE_TOKEN=

# Development Settings
# Telegram polling is enabled by default; set false to run API without bot polling.
ENABLE_TELEGRAM_POLLING=true
# Reserved for webhook deployments; when true, polling launch is skipped.
WEBHOOK_MODE=false
DOWNLOADS_PATH=./downloads

# Logging Configuration
# Levels: error, warn, info, debug
LOG_LEVEL=info
