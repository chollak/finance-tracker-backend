# Application Configuration
NODE_ENV=development
PORT=3000

# Database: SQLite via TypeORM is the only option (data/database.sqlite).
# Schema changes are migrations applied on start; see docs/knowledge-base/08-development/database-guide.md
DATABASE_TYPE=sqlite

# Free-tier limits (50 records, 10 voice inputs a month). Off during milestone 10 (decision Д3).
FREE_LIMITS_ENABLED=false

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
WHISPER_MODEL=whisper-1
# Optional: a stuck OpenAI request ends after this many ms; text parsing is retried this many times, voice never (FT-145)
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1
DEFAULT_LANGUAGE=ru

# Telegram Bot
TG_BOT_API_KEY=your-telegram-bot-token
# Closed access (FT-153): the bot, the API and the notices only for these Telegram user ids, comma-separated
# (spaces are fine). Anyone else: the bot stays silent, the API answers 403 ACCESS_NOT_ALLOWED, no user row is made.
# Empty lets everyone in outside production; NODE_ENV=production does not start without it.
# An entry that is not a whole number stops the start everywhere.
ALLOWED_TELEGRAM_IDS=
# Optional: the bot's @username (without @) for the web login link t.me/<bot>?start=login_… (FT-128).
# When empty the server asks Telegram (getMe).
TG_BOT_USERNAME=
WEB_APP_URL=http://localhost:3000
# Optional: chat/user id used by npm run dev:miniapp / miniapp:menu helpers to update Telegram menu button
MINIAPP_CHAT_ID=
# Optional: use an ngrok URL in local development; AppConfig prefers it when NODE_ENV=development
NGROK_URL=

# Quick Capture from the iPhone — Shortcut on the Action Button → POST /api/quick-capture (FT-075, FT-155).
# The Shortcut sends the token in X-Shortcut-Capture-Token; every capture is written for SHORTCUT_CAPTURE_OWNER,
# a Telegram user id (X-Shortcut-User-Id is optional and, if sent, must be the owner). Never commit a real token.
# - NODE_ENV=production: set both or neither. Neither turns the Shortcut off (403 SHORTCUT_CAPTURE_DISABLED).
#   The token must be at least 32 characters (`openssl rand -hex 32`) and the owner must be in ALLOWED_TELEGRAM_IDS;
#   a short token, one without the other or an owner off the list stops the start.
# - Outside production: the token is optional and only required from the phone (tunnel, Wi-Fi), otherwise
#   403 SHORTCUT_CAPTURE_TOKEN_REQUIRED; without an owner the X-Shortcut-User-Id header names it.
# Revoking a token: put a new value here and restart the server; the old one stops working at once.
SHORTCUT_CAPTURE_TOKEN=
SHORTCUT_CAPTURE_OWNER=

# Development Settings
# Telegram polling is enabled by default; set false to run API without bot polling.
ENABLE_TELEGRAM_POLLING=true
# Reserved for webhook deployments; when true, polling launch is skipped.
WEBHOOK_MODE=false
DOWNLOADS_PATH=./downloads

# Logging Configuration
# Levels: error, warn, info, debug
LOG_LEVEL=info
