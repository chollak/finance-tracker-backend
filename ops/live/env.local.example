# The live instance on the PC (FT-156): copy to ~/daftar-live/.env.local and fill in the empty values.
#   cp ops/live/env.local.example .env.local && chmod 600 .env.local
# The filled file holds secrets: it stays on the PC and is ignored by git. Steps and reasons:
# docs/knowledge-base/08-development/live-instance.md

# Production: closed access is enforced, developer headers and detailed errors are off.
# The systemd unit pins NODE_ENV=production too; this line is for commands run by hand (migration:show and the like).
NODE_ENV=production
# The old budget, dashboard and limits code reads the machine clock: the app runs on Tashkent time whatever WSL says
TZ=Asia/Tashkent
PORT=3000
DATABASE_TYPE=sqlite
LOG_LEVEL=info

# Closed access (FT-153): Telegram user ids allowed in, comma-separated. Production does not start without it.
ALLOWED_TELEGRAM_IDS=

# The live bot. Its token is not the Mac dev bot's: two processes polling one token get 409 and knock each other off.
TG_BOT_API_KEY=
# The bot's @username without @, for the web login link (FT-128); empty asks Telegram
TG_BOT_USERNAME=
ENABLE_TELEGRAM_POLLING=true
WEBHOOK_MODE=false

# The tailnet address that `tailscale serve` gives the PC, https://<pc>.<tailnet>.ts.net, no trailing slash.
# `npm run miniapp:menu -- set` writes it here and points the bot's menu button at it; restart the service after.
WEB_APP_URL=
# Your Telegram user id for the menu button (the same as in ALLOWED_TELEGRAM_IDS) and the button's text
MINIAPP_CHAT_ID=
MINIAPP_MENU_TEXT=Daftar

# OpenAI: the live instance's own key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WHISPER_MODEL=whisper-1
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1
DEFAULT_LANGUAGE=ru

# Free-tier limits stay off during milestone 10 (decision Д3)
FREE_LIMITS_ENABLED=false

# After FT-155 — quick capture from the iPhone (Action Button). Uncomment once FT-155 is in main:
# a token of at least 32 characters (for example `openssl rand -hex 32`) and the Telegram id that owns its records,
# which must be in ALLOWED_TELEGRAM_IDS. Revoking: a new value here and `sudo systemctl restart daftar`.
# SHORTCUT_CAPTURE_TOKEN=
# SHORTCUT_CAPTURE_OWNER=
