# The live instance on the PC (FT-156): copy to ~/kapelka-live/.env.local and fill in the empty values.
#   cp ops/live/env.local.example .env.local && chmod 600 .env.local
# The filled file holds secrets: it stays on the PC and is ignored by git. Steps and reasons:
# docs/knowledge-base/08-development/live-instance.md

# Production: closed access is enforced, developer headers and detailed errors are off.
# The systemd unit pins NODE_ENV=production too; this line is for commands run by hand (migration:show and the like).
NODE_ENV=production
# The old budget, dashboard and limits code reads the machine clock: the app runs on Tashkent time whatever WSL says
TZ=Asia/Tashkent
PORT=3000
DATABASE_TYPE=sqlite
LOG_LEVEL=info

# The nightly backup (FT-157, scripts/backup-db.sh): a plain folder on drive C: that Google Drive for desktop syncs
# (Preferences → Folders from your computer), C:\KapelkaBackup here. The app does not read it. The folder must exist:
# the backup never creates it and fails instead. Never the live data/ itself — sync corrupts a SQLite file in use
BACKUP_DIR=/mnt/c/KapelkaBackup

# Closed access (FT-153): Telegram user ids allowed in, comma-separated. Production does not start without it.
ALLOWED_TELEGRAM_IDS=
# Optional: Telegram ids for the admin routes (OpenAI usage, subscriptions), comma-separated; empty — nobody
ADMIN_TELEGRAM_IDS=

# The bot. The PC gets its own new bot «Kapelka» from BotFather (@kapelkabot or the free name it got, decision
# 2026-10-28); @FinanceTrackerDevBot stays with the Mac as the development bot — never put its token here.
# One token is polled by one process only: a second one gets 409, and in production it then exits (FT-154).
TG_BOT_API_KEY=
# The bot's @username without @, for the web login link (FT-128); empty asks Telegram
TG_BOT_USERNAME=
# false until the move: records written to the bot before it would land in this empty database and be lost when the
# Mac's database replaces it. true at the move (FT-159), once the Mac's database is here, or for a rehearsal whose
# records you do not need. Steps: «Переезд» in live-instance.md
ENABLE_TELEGRAM_POLLING=false
WEBHOOK_MODE=false

# The tailnet address that `tailscale serve` gives the PC, https://<pc>.<tailnet>.ts.net, no trailing slash.
# `npm run miniapp:menu -- set` writes it here and points the bot's menu button at it; restart the service after.
WEB_APP_URL=
# Your Telegram user id for the menu button (the same as in ALLOWED_TELEGRAM_IDS) and the button's text
MINIAPP_CHAT_ID=
MINIAPP_MENU_TEXT=Kapelka

# OpenAI: the live instance's own key. Leave OPENAI_ORG_ID unset: the app does not read it, but the openai SDK picks it
# up from the environment, and a wrong one fails every request, voice transcription too, with 401
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WHISPER_MODEL=whisper-1
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1
DEFAULT_LANGUAGE=ru

# Free-tier limits stay off during milestone 10 (decision Д3)
FREE_LIMITS_ENABLED=false

# Quick capture from the iPhone — Shortcut on the Action Button → POST /api/quick-capture (FT-155).
# Set both or neither: both empty turn the Shortcut off (403 SHORTCUT_CAPTURE_DISABLED). One without the other, a token
# shorter than 32 characters or an owner missing from ALLOWED_TELEGRAM_IDS stops the start — and with Restart=always
# the service then restarts in a loop: journalctl -u kapelka shows «Configuration validation failed».
# The token: `openssl rand -hex 32`, never committed. The owner: the Telegram id every capture is written for.
# Revoking: a new token here and `sudo systemctl restart kapelka`; the old one stops working at once.
SHORTCUT_CAPTURE_TOKEN=
SHORTCUT_CAPTURE_OWNER=
